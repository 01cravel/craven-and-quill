OPENAI_API_KEY=
SIGNUPS_EXPORT_TOKEN=

# Book orders. Set secret values through Sites settings, never in this file.
# PRODIGI_API_KEY=
# ORDER_LINK_SECRET=
# ORDERS_ADMIN_EMAIL=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# RESEND_API_KEY=
# ORDER_EMAIL_FROM=
# ORDERS_ENABLED=false
# ORDER_TAX_CONFIRMED=false

# Ziina pilot. Keep ORDERS_ENABLED=false until account, webhook and live QA are verified.
PAYMENT_PROVIDER=ziina
ZIINA_MODE=test
ZIINA_ACCESS_TOKEN=
ZIINA_ACCOUNT_ID=
ZIINA_WEBHOOK_SECRET=

# UK address finder (Ideal Postcodes). Key starts ak_. Without it the delivery step falls back to typing the address.
# IDEAL_POSTCODES_API_KEY=

# Book sale alerts use the owner-only Site tool. No new URL or token is needed.

# Consent-gated Google Ads. IDs/labels are public configuration; the feed password is secret.
GOOGLE_ADS_TAG_ID=
GOOGLE_ADS_PURCHASE_LABEL=
GOOGLE_ADS_LEAD_LABEL=
# Dedicated read-only HTTPS report credential, at least 32 random characters. Username: google-ads
GOOGLE_ADS_FEED_PASSWORD=

# Consent-gated Meta. The pixel id is public; the Conversions API token is secret and lets the server report
# purchases (click reference, total and country only, never an email) after a customer allowed ad measurement.
META_PIXEL_ID=
META_CAPI_TOKEN=
